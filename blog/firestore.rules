rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasEmail(email) {
      return request.auth != null && request.auth.token.email == email;
    }
    function isMainEditor() {
      return hasEmail('mmartinezf001@educarex.es');
    }
    function isAulaEditor() {
      return hasEmail('fmhernandezr02@educarex.es')
        || hasEmail('mmartinezf001@educarex.es');
    }
    function isMeteoEditor() {
      return hasEmail('mmartinezf001@educarex.es')
        || hasEmail('fjboraitab01@educarex.es');
    }
    function isHuertoEditor() {
      return hasEmail('mmartinezf001@educarex.es')
        || hasEmail('silverio68@educarex.es');
    }

    // Public visitors may only increment the view counter of a published post.
    function isPostView() {
      return resource.data.status == 'published'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views is int
        && request.resource.data.views == resource.data.get('views', 0) + 1;
    }

    match /articles/{articleId} {
      allow read: if resource.data.status == 'published' || isMainEditor();
      allow create, delete: if isMainEditor();
      allow update: if isMainEditor()
        || (resource.data.status == 'published'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == resource.data.views + 1);
    }

    match /citePosts/{postId} {
      allow read: if resource.data.status == 'published' || isMainEditor();
      allow create, delete: if isMainEditor();
      allow update: if isMainEditor() || isPostView();
    }

    match /aulaBlogPosts/{postId} {
      allow read: if resource.data.status == 'published' || isAulaEditor();
      allow create, delete: if isAulaEditor();
      allow update: if isAulaEditor() || isPostView();
    }

    match /meteoBlogPosts/{postId} {
      allow read: if resource.data.status == 'published' || isMeteoEditor();
      allow create, delete: if isMeteoEditor();
      allow update: if isMeteoEditor() || isPostView();
    }

    match /huertoBlogPosts/{postId} {
      allow read: if resource.data.status == 'published' || isHuertoEditor();
      allow create, delete: if isHuertoEditor();
      allow update: if isHuertoEditor() || isPostView();
    }
  }
}


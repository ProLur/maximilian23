rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pageStats/{pageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['path', 'title', 'total', 'lastVisit', 'devices', 'days'])
        && request.resource.data.path is string
        && request.resource.data.title is string
        && request.resource.data.total is int
        && request.resource.data.total == 1
        && request.resource.data.lastVisit == request.time
        && request.resource.data.devices is map
        && request.resource.data.days is map;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', 'lastVisit', 'devices', 'days'])
        && request.resource.data.path == resource.data.path
        && request.resource.data.title == resource.data.title
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.lastVisit == request.time
        && request.resource.data.devices is map
        && request.resource.data.days is map;
      allow delete: if false;
    }
  }
}
